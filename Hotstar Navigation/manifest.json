
{
  "manifest_version": 3,
  "name": "Browser Navigation Keys",
  "version": "2.0",
  "description": "Control browser Back and Forward using simple keyboard shortcuts",
  "permissions": [
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "go-back": {
      "suggested_key": {
        "default": "Alt+U"
      },
      "description": "Navigate Back"
    },
    "go-forward": {
      "suggested_key": {
        "default": "Alt+Y"
      },
      "description": "Navigate Forward"
    },
    "toggle-navigation": {
      "suggested_key": {
        "default": "Alt+E"
      },
      "description": "Enable or Disable Navigation"
    }
  }
}
