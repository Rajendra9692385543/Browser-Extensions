
{
  "manifest_version": 3,
  "name": "Hotstar Navigation Keys",
  "version": "1.1",
  "description": "Navigate browser history using keyboard shortcuts",
  "permissions": ["tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
  "go-back": {
    "suggested_key": {
      "default": "Ctrl+Shift+U"
    },
    "description": "Browser Back"
  },
  "go-forward": {
    "suggested_key": {
      "default": "Ctrl+Shift+Y"
    },
    "description": "Browser Forward"
  }
}
}
