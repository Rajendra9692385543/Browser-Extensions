
{
  "manifest_version": 3,
  "name": "Browser Navigation Keys",
  "version": "3.0",
  "description": "Navigate browser history using simple keyboard shortcuts.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Browser Navigation Keys",
    "default_popup": "popup.html"
  },
  "commands": {
  "go-back": {
    "suggested_key": {
      "default": "Alt+Y"
    },
    "description": "Navigate Back"
  },
  "go-forward": {
    "suggested_key": {
      "default": "Alt+U"
    },
    "description": "Navigate Forward"
  },
  "toggle-navigation": {
    "suggested_key": {
      "default": "Alt+Q"
    },
    "description": "Enable or Disable Navigation"
  }
}
}
